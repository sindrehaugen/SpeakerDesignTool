{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speaker Design Tool",
  "version": "3.0.0",
  "identifier": "com.speakerdesigntool.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Speaker Design Tool",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "category": "Productivity",
    "shortDescription": "Speaker installation design tool with spectral physics engine.",
    "longDescription": "Low-Z and 100V/70V loudspeaker design with 3D room view, SPL coverage heatmap, acoustics calculators (Cramer 1993 / ISO 9613-1), and a subwoofer-array beamforming designer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
